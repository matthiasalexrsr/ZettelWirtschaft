{
  "manifest_version": 2,
  "name": "DocuDesk Bridge",
  "description": "Thunderbird-Bridge für DocuDesk",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "[email protected]",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messageDisplay",
    "compose",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
