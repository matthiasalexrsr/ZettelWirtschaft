<Page
    x:Class="DocuDesk.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <TextBlock Text="Suche" FontSize="28" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBox x:Name="QueryTextBox"
                     Width="520"
                     PlaceholderText="Dokumente, Absender oder OCR-Inhalte durchsuchen"
                     Text="{Binding QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Suchen" Click="OnSearchClicked" />
            <ProgressRing Width="24" Height="24" IsActive="{Binding IsBusy}" />
        </StackPanel>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock Text="{Binding StatusMessage}" />
            <InfoBar Grid.Row="1"
                     IsOpen="{Binding HasError}"
                     IsClosable="False"
                     Severity="Error"
                     Title="Fehler"
                     Message="{Binding ErrorMessage}" />
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Text="{Binding ResultCountText}" FontWeight="SemiBold" />

            <ListView Grid.Row="1"
                      ItemsSource="{Binding Results}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnResultInvoked">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                <TextBlock Grid.Row="1" Text="{Binding SecondaryText}" TextWrapping="WrapWholeWords" />
                                <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="2">
                                    <TextBlock Text="{Binding Snippet}" TextWrapping="WrapWholeWords" />
                                    <TextBlock Text="{Binding RankText}" Opacity="0.7" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
