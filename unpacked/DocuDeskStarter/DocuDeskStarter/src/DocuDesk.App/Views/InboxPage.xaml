<Page
    x:Class="DocuDesk.App.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Inbox" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="Datei importieren" Click="OnImportClicked" />
            <Button Content="Aktualisieren" Click="OnRefreshClicked" />
            <ProgressRing Width="24" Height="24" IsActive="{Binding IsBusy}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" />

        <InfoBar Grid.Row="2"
                 IsOpen="{Binding HasError}"
                 IsClosable="False"
                 Severity="Error"
                 Title="Fehler"
                 Message="{Binding ErrorMessage}" />

        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
            <TextBlock Text="{Binding DocumentCountText}" FontWeight="SemiBold" />

            <ListView Grid.Row="1"
                      ItemsSource="{Binding Documents}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnDocumentInvoked">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="4">
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SecondaryText}" TextWrapping="WrapWholeWords" />
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding ImportDateText}" />
                                    <TextBlock Text="{Binding PageCountText}" />
                                </StackPanel>
                                <TextBlock Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           Text="Klick öffnet Dokumentdetails"
                                           Opacity="0.7" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
