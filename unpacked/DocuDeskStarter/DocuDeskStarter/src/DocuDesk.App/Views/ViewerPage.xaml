<Page
    x:Class="DocuDesk.App.Views.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Dokumentviewer" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ProgressRing Width="24" Height="24" IsActive="{Binding IsBusy}" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock Text="{Binding StatusMessage}" />
            <InfoBar Grid.Row="1"
                     IsOpen="{Binding HasError}"
                     IsClosable="False"
                     Severity="Error"
                     Title="Fehler"
                     Message="{Binding ErrorMessage}" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="260,*,420" ColumnSpacing="16">
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12" CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <TextBlock Text="Seiten" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding PageSelectionText}" Opacity="0.8" />
                    <ListView x:Name="PagesListView"
                              Grid.Row="2"
                              ItemsSource="{Binding Pages}"
                              SelectionMode="Single"
                              SelectionChanged="OnPagesSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PageText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RotationText}" />
                                        <TextBlock Text="{Binding PreviewText}" TextWrapping="WrapWholeWords" Opacity="0.7" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12" CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="←" Click="OnPreviousPageClicked" IsEnabled="{Binding CanGoToPreviousPage}" />
                        <Button Content="→" Click="OnNextPageClicked" IsEnabled="{Binding CanGoToNextPage}" />
                        <Button Content="Originaldatei öffnen" Click="OnOpenOriginalClicked" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="4">
                        <TextBlock Text="{Binding ViewerStatusText}" />
                        <TextBlock Text="{Binding PreviewHintText}" TextWrapping="WrapWholeWords" Opacity="0.8" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Border x:Name="PlaceholderBorder"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Keine eingebettete Vorschau verfügbar" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding StoragePath}" TextWrapping="WrapWholeWords" MaxWidth="420" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <WebView2 x:Name="PdfWebView" Visibility="Collapsed" />

                        <ScrollViewer x:Name="ImageScrollViewer" Visibility="Collapsed" ZoomMode="Enabled">
                            <Image x:Name="PreviewImage" Stretch="Uniform" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="12" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="10">
                            <TextBlock Text="Metadaten" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="Änderungen speichern"
                                    Click="OnSaveMetadataClicked"
                                    IsEnabled="{Binding CanSaveMetadata}" />
                        </StackPanel>

                        <TextBox Header="Titel"
                                 Text="{Binding EditableTitle, Mode=TwoWay}" />

                        <ComboBox Header="Kategorie"
                                  ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />

                        <TextBox Header="Absender"
                                 Text="{Binding EditableSender, Mode=TwoWay}" />

                        <TextBox Header="Empfänger"
                                 Text="{Binding EditableRecipient, Mode=TwoWay}" />

                        <TextBox Header="Dokumentdatum"
                                 PlaceholderText="TT.MM.JJJJ oder JJJJ-MM-TT"
                                 Text="{Binding EditableDocumentDateText, Mode=TwoWay}" />

                        <TextBox Header="Notizen"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 Text="{Binding EditableNotes, Mode=TwoWay}" />

                        <TextBlock Text="Tags" FontWeight="SemiBold" />
                        <ListView ItemsSource="{Binding TagOptions}"
                                  SelectionMode="None"
                                  MinHeight="120"
                                  MaxHeight="220">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="Aktuelle Auswahl" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TagSummary}" TextWrapping="WrapWholeWords" />

                        <TextBlock Text="Status" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}" />
                        <TextBlock Text="Importiert" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ImportDateText}" />
                        <TextBlock Text="Dateiname" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OriginalFileName}" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="Repository-Pfad" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StoragePath}" TextWrapping="WrapWholeWords" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="OCR" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="OCR ausführen"
                                    Click="OnRunOcrClicked"
                                    IsEnabled="{Binding CanRunOcr}" />
                        </StackPanel>

                        <TextBox Header="OCR-Sprachen"
                                 PlaceholderText="z. B. deu+eng"
                                 Text="{Binding OcrLanguage, Mode=TwoWay}" />

                        <TextBlock Text="{Binding OcrInfoText}" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{Binding OcrArtifactText}" TextWrapping="WrapWholeWords" Opacity="0.8" />
                        <TextBox AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="180"
                                 Text="{Binding OcrPreviewText}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
