<Window
    x:Class="DocuDesk.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DocuDesk">

    <Grid>
        <NavigationView x:Name="RootNavigationView"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="inbox" Icon="Home" Content="Inbox" />
                <NavigationViewItem Tag="search" Icon="Find" Content="Suche" />
                <NavigationViewItem Tag="viewer" Icon="Document" Content="Viewer" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
