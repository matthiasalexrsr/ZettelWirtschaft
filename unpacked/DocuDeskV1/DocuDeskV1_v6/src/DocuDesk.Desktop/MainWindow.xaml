<Window x:Class="DocuDesk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewer="clr-namespace:DocuDesk.Viewer;assembly=DocuDesk.Viewer"
        mc:Ignorable="d"
        Title="DocuDesk"
        Height="920"
        Width="1520"
        MinHeight="760"
        MinWidth="1260"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">
    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBackground" Color="#111827" />
        <SolidColorBrush x:Key="SidebarForeground" Color="#D1D5DB" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="CardBorder" Color="#E5EAF2" />
        <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SidebarForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2937" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="DocuDesk" Foreground="White" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="WPF Document Workspace" Foreground="#9CA3AF" Margin="0,4,0,24" />

                    <Button Style="{StaticResource NavButtonStyle}" Content="📥  Inbox" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="📄  Alle Dokumente" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="🔎  Suche" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="🏷️  Kategorien" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="🧪  Jobs &amp; Diagnose" />
                    <Button Style="{StaticResource NavButtonStyle}" Content="⚙️  Einstellungen" />
                </StackPanel>

                <Border Grid.Row="2"
                        Background="#0B1220"
                        BorderBrush="#1F2937"
                        BorderThickness="1"
                        Padding="12"
                        CornerRadius="8">
                    <TextBlock Foreground="#9CA3AF"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Text="Hinweis: Diese Oberfläche nutzt den bestehenden MainViewModel-Flow ohne Command-/Binding-Änderungen." />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="270" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="450"
                                 Height="38"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,12,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Suchen" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Import" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ImportCommand}" />
                        <Button Content="Jobs verarbeiten" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ProcessJobsCommand}" />
                        <Button Content="Backup" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BackupCommand}" />
                        <Button Content="Mail-Entwurf" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DraftMailCommand}" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,16,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="12"
                        Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Text="Dokumente" />
                        <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" Margin="0,12,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,0,0,2" BorderBrush="#EFF3F8" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#6B7280" FontSize="12" />
                                            <TextBlock Text="{Binding ImportedAt}" FontSize="12" />
                                            <TextBlock Text="{Binding OcrStatus}" FontSize="12" Foreground="#2563EB" />
                                            <TextBlock Text="{Binding MatchSnippet}" Foreground="#374151" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="12"
                        Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Text="Viewer" />
                        <viewer:ViewerHostControl x:Name="DocumentViewer"
                                                  Margin="0,12,0,0"
                                                  SourcePath="{Binding SelectedDocumentPath}"
                                                  OverlayJson="{Binding SelectedDocumentOverlayJson}"
                                                  HighlightQuery="{Binding SearchText}" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource CardBackground}"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        Padding="14">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Text="Dokumentdetails" />
                        <TextBlock Margin="0,12,0,0" Text="Titel" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDocument.Title}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Datei" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDocument.DisplayName}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Absender" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDocument.Sender}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Dokumenttyp" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDocument.DocumentType}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Repository-Pfad" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDocument.RepositoryPath}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Text="Jobs &amp; Diagnose" />
                    <ListBox ItemsSource="{Binding Jobs}" Margin="0,12,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding JobType}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CreatedAt}" />
                                    <TextBlock Grid.Column="3" Text="{Binding ErrorText}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
