<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\database\ddl_v1.sql">
      <Link>database\ddl_v1.sql</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\DocuDesk.Viewer\viewer-assets\**\*">
      <Link>viewer-assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DocuDesk.Domain\DocuDesk.Domain.csproj" />
    <ProjectReference Include="..\DocuDesk.Contracts\DocuDesk.Contracts.csproj" />
    <ProjectReference Include="..\DocuDesk.Application\DocuDesk.Application.csproj" />
    <ProjectReference Include="..\DocuDesk.Persistence\DocuDesk.Persistence.csproj" />
    <ProjectReference Include="..\DocuDesk.Infrastructure\DocuDesk.Infrastructure.csproj" />
    <ProjectReference Include="..\DocuDesk.Worker\DocuDesk.Worker.csproj" />
    <ProjectReference Include="..\DocuDesk.Integrations.Mail\DocuDesk.Integrations.Mail.csproj" />
    <ProjectReference Include="..\DocuDesk.Viewer\DocuDesk.Viewer.csproj" />
  </ItemGroup>
</Project>
