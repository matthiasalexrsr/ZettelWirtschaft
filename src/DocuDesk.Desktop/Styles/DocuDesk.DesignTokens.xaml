<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base palette -->
    <Color x:Key="Color.AppBackground">#F3F6FB</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#F8FAFC</Color>
    <Color x:Key="Color.Border">#D8E0EB</Color>
    <Color x:Key="Color.TextPrimary">#0F172A</Color>
    <Color x:Key="Color.TextSecondary">#475569</Color>
    <Color x:Key="Color.TextMuted">#64748B</Color>
    <Color x:Key="Color.Accent">#2563EB</Color>
    <Color x:Key="Color.AccentStrong">#1D4ED8</Color>
    <Color x:Key="Color.AccentSoft">#DBEAFE</Color>
    <Color x:Key="Color.NavBackground">#0F172A</Color>
    <Color x:Key="Color.NavSurface">#1E293B</Color>
    <Color x:Key="Color.Success">#16A34A</Color>
    <Color x:Key="Color.Warning">#D97706</Color>
    <Color x:Key="Color.Danger">#DC2626</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="Brush.AppBackground" Color="{StaticResource Color.AppBackground}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="{StaticResource Color.AccentStrong}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.NavBackground" Color="{StaticResource Color.NavBackground}" />
    <SolidColorBrush x:Key="Brush.NavSurface" Color="{StaticResource Color.NavSurface}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />

    <!-- Typography -->
    <FontFamily x:Key="FontFamily.App">Segoe UI</FontFamily>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Body">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Subtitle">16</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Title">20</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSize.Hero">28</sys:Double>

    <!-- Sizing -->
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <Thickness x:Key="Thickness.CardPadding">20</Thickness>
    <Thickness x:Key="Thickness.ControlPadding">14,10</Thickness>
    <Thickness x:Key="Thickness.SectionSpacing">0,0,0,16</Thickness>
</ResourceDictionary>