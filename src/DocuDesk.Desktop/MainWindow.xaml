<Window x:Class="DocuDesk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewer="clr-namespace:DocuDesk.Viewer;assembly=DocuDesk.Viewer"
        mc:Ignorable="d"
        Title="DocuDesk"
        Height="900"
        Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F2937">
            <StackPanel Margin="20">
                <TextBlock Text="DocuDesk" Foreground="White" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Dokumentenverwaltung" Foreground="#D1D5DB" Margin="0,4,0,24" />

                <Button Content="Inbox" Margin="0,0,0,10" Padding="12,8" />
                <Button Content="Alle Dokumente" Margin="0,0,0,10" Padding="12,8" />
                <Button Content="Suche" Margin="0,0,0,10" Padding="12,8" />
                <Button Content="Kategorien" Margin="0,0,0,10" Padding="12,8" />
                <Button Content="Jobs &amp; Diagnose" Margin="0,0,0,10" Padding="12,8" />
                <Button Content="Einstellungen" Margin="0,0,0,10" Padding="12,8" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="280" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBox Width="420" Height="36" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Padding="18,8" Content="Suchen" Command="{Binding SearchCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Padding="14,8" Content="Import" Command="{Binding ImportCommand}" />
                        <Button Margin="12,0,0,0" Padding="14,8" Content="Jobs verarbeiten" Command="{Binding ProcessJobsCommand}" />
                        <Button Margin="12,0,0,0" Padding="14,8" Content="Backup" Command="{Binding BackupCommand}" />
                        <Button Margin="12,0,0,0" Padding="14,8" Content="Mail-Entwurf" Command="{Binding DraftMailCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,16,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Text="Dokumente" />
                        <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" Margin="0,12,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#6B7280" FontSize="12" />
                                            <TextBlock Text="{Binding ImportedAt}" FontSize="12" />
                                            <TextBlock Text="{Binding OcrStatus}" FontSize="12" Foreground="#2563EB" />
                                            <TextBlock Text="{Binding MatchSnippet}" Foreground="#374151" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Text="Viewer" />
                        <viewer:ViewerHostControl x:Name="DocumentViewer" Margin="0,12,0,0" SourcePath="{Binding SelectedDocumentPath}" OverlayJson="{Binding SelectedDocumentOverlayJson}" HighlightQuery="{Binding SearchText}" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Text="Dokumentdetails" />
                        <TextBlock Margin="0,12,0,0" Text="Titel" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDocument.Title}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Datei" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDocument.DisplayName}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Absender" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDocument.Sender}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Dokumenttyp" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDocument.DocumentType}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Text="Repository-Pfad" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedDocument.RepositoryPath}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="Bold" Text="Jobs &amp; Diagnose" />
                    <ListBox ItemsSource="{Binding Jobs}" Margin="0,12,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding JobType}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CreatedAt}" />
                                    <TextBlock Grid.Column="3" Text="{Binding ErrorText}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
