<Window x:Class="DocuDesk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewer="clr-namespace:DocuDesk.Viewer;assembly=DocuDesk.Viewer"
        mc:Ignorable="d"
        Title="DocuDesk"
        Height="900"
        Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Brush.SidebarBackground}">
            <StackPanel Margin="20">
                <TextBlock Text="DocuDesk" Foreground="White" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Dokumentenverwaltung"
                           Foreground="{StaticResource Brush.SidebarSubtleText}"
                           Margin="0,4,0,24" />

                <Button Style="{StaticResource SidebarButtonStyle}" Content="Inbox" />
                <Button Style="{StaticResource SidebarButtonStyle}" Content="Alle Dokumente" />
                <Button Style="{StaticResource SidebarButtonStyle}" Content="Suche" />
                <Button Style="{StaticResource SidebarButtonStyle}" Content="Kategorien" />
                <Button Style="{StaticResource SidebarButtonStyle}" Content="Jobs &amp; Diagnose" />
                <Button Style="{StaticResource SidebarButtonStyle}" Content="Einstellungen" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="280" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBox Width="420" Height="36" Margin="0,0,12,0" VerticalContentAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Padding="18,8"
                                Margin="0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Suchen"
                                Command="{Binding SearchCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Import" Command="{Binding ImportCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Jobs verarbeiten" Command="{Binding ProcessJobsCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Backup" Command="{Binding BackupCommand}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Mail-Entwurf" Command="{Binding DraftMailCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,16,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,12,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Dokumente" />
                            <Border Margin="10,2,0,0" Padding="8,2" CornerRadius="10" Background="#FFEFF6FF">
                                <TextBlock Text="{Binding Documents.Count, StringFormat={}{0} Treffer}" Foreground="{StaticResource Brush.Primary}" FontSize="12" />
                            </Border>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Documents}"
                                 SelectedItem="{Binding SelectedDocument}"
                                 ItemContainerStyle="{StaticResource DocumentListItemStyle}"
                                 Margin="0,12,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Brush.MutedText}" FontSize="12" />
                                            <TextBlock Text="{Binding ImportedAt}" FontSize="12" />
                                            <TextBlock Text="{Binding OcrStatus}" FontSize="12" Foreground="#2563EB" />
                                            <TextBlock Text="{Binding MatchSnippet}" Foreground="{StaticResource Brush.MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeaderTextStyle}" Text="Viewer" />
                        <viewer:ViewerHostControl x:Name="DocumentViewer" Margin="0,12,0,0" SourcePath="{Binding SelectedDocumentPath}" OverlayJson="{Binding SelectedDocumentOverlayJson}" HighlightQuery="{Binding SearchText}" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Dokumentdetails" />
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Titel" FontWeight="SemiBold" Margin="0,0,8,10" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDocument.Title}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Datei" FontWeight="SemiBold" Margin="0,0,8,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDocument.DisplayName}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Absender" FontWeight="SemiBold" Margin="0,0,8,10" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDocument.Sender}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Dokumenttyp" FontWeight="SemiBold" Margin="0,0,8,10" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDocument.DocumentType}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Repository" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDocument.RepositoryPath}" TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeaderTextStyle}" Text="Jobs &amp; Diagnose" />
                    <ListBox ItemsSource="{Binding Jobs}" Margin="0,12,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding JobType}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" />
                                    <TextBlock Grid.Column="2" Text="{Binding CreatedAt}" />
                                    <TextBlock Grid.Column="3" Text="{Binding ErrorText}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
